# apps/api — copy to .env (never commit .env)
# Local Postgres: docker compose up postgres -d
DATABASE_URL="postgresql://saas:saas@localhost:5432/saas?schema=public"
REDIS_URL="redis://localhost:6379"
PORT=3000
NODE_ENV=development

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3001,http://localhost:4173,https://www.magicmet.ru,https://magicmet.ru

JWT_SECRET=dev-local-jwt-secret-change-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Website → SaaS public intake.
# Must equal SAAS_SITE_INGEST_TOKEN in the website hosting environment.
SITE_INGEST_TOKEN=
# Prefer a stable organization UUID. INN is used only as a fallback lookup.
PUBLIC_INTAKE_ORGANIZATION_ID=
PUBLIC_INTAKE_ORGANIZATION_INN=7453362080
PUBLIC_INTAKE_ALLOWED_ORIGINS=https://www.magicmet.ru,https://magicmet.ru,http://localhost:4173

SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
